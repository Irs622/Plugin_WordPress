#. Plugin Name of the plugin
#: wp-knowledge-chat.php
#: includes/class-admin-page.php:30
#: includes/class-admin-page.php:31
msgid "WP Knowledge Chat"
msgstr "WP Knowledge Chat"

#. Description of the plugin
#: wp-knowledge-chat.php
msgid "Inpartner AI Business Consultation Assistant: a floating chat widget that answers visitor questions from approved website content via a separate AI backend."
msgstr "Inpartner AI Business Consultation Assistant: 승인된 웹사이트 콘텐츠를 바탕으로 별도의 AI 백엔드를 통해 방문자 질문에 답하는 플로팅 채팅 위젯입니다."

#. Author of the plugin
#: wp-knowledge-chat.php
msgid "Inpartner"
msgstr "Inpartner"

#: includes/class-admin-page.php:40
#: includes/class-admin-page.php:174
msgid "WP Knowledge Chat Settings"
msgstr "WP Knowledge Chat 설정"

#: includes/class-admin-page.php:41
#: includes/class-plugin.php:76
msgid "Settings"
msgstr "설정"

#: includes/class-admin-page.php:49
msgid "Chat widget"
msgstr "채팅 위젯"

#: includes/class-admin-page.php:52
msgid "Enable Chatbot"
msgstr "챗봇 사용"

#: includes/class-admin-page.php:53
#: includes/class-admin-page.php:102
msgid "Greeting Messages"
msgstr "인사말"

#: includes/class-admin-page.php:54
msgid "Default Language"
msgstr "기본 언어"

#: includes/class-admin-page.php:55
msgid "Language Switcher"
msgstr "언어 전환"

#: includes/class-admin-page.php:56
msgid "Browser Language"
msgstr "브라우저 언어"

#: includes/class-admin-page.php:57
msgid "Contact URL"
msgstr "문의 URL"

#: includes/class-admin-page.php:97
msgid "Show the chat widget on the public site."
msgstr "공개 사이트에 채팅 위젯을 표시합니다."

#. translators: %d: maximum characters.
#: includes/class-admin-page.php:120
#, php-format
msgid "Shown when the chat opens, in the visitor's language. Plain text only (HTML is removed). Maximum %d characters. Leave a field empty to restore its default."
msgstr "채팅을 열면 방문자의 언어로 표시됩니다. 일반 텍스트만 가능합니다(HTML은 제거됨). 최대 %d자. 칸을 비워 두면 기본 인사말로 돌아갑니다."

#: includes/class-admin-page.php:132
msgid "Interface language and preferred answer language when the visitor has not chosen one. Source content is not altered."
msgstr "방문자가 언어를 선택하지 않았을 때의 인터페이스 언어 및 답변 언어입니다. 원본 콘텐츠는 변경되지 않습니다."

#: includes/class-admin-page.php:138
msgid "Let visitors switch between English, Bahasa Indonesia and 한국어 in the chat header."
msgstr "방문자가 채팅 헤더에서 English, Bahasa Indonesia, 한국어 사이를 전환할 수 있습니다."

#: includes/class-admin-page.php:139
msgid "Start in the visitor's browser language when it is supported; otherwise use the default language."
msgstr "지원되는 경우 방문자의 브라우저 언어로 시작하고, 그렇지 않으면 기본 언어를 사용합니다."

#. translators: %s: approved hostnames.
#: includes/class-admin-page.php:159
#, php-format
msgid "Absolute https:// URL on an approved domain: %s."
msgstr "승인된 도메인의 절대 https:// URL: %s."

#: includes/class-admin-page.php:170
msgid "You do not have permission to manage these settings."
msgstr "이 설정을 관리할 권한이 없습니다."

#: includes/class-admin-page.php:196
msgid "AI backend"
msgstr "AI 백엔드"

#: includes/class-admin-page.php:198
msgid "Configured."
msgstr "구성됨."

#: includes/class-admin-page.php:199
msgid "The backend URL and shared secret are read from wp-config.php and are never shown here or sent to browsers."
msgstr "백엔드 URL과 공유 비밀 키는 wp-config.php에서 읽으며, 여기에 표시되거나 브라우저로 전송되지 않습니다."

#: includes/class-admin-page.php:201
msgid "Not configured."
msgstr "구성되지 않음."

#: includes/class-admin-page.php:202
msgid "The widget stays hidden until WP_KNOWLEDGE_CHAT_BACKEND_URL (https) and WP_KNOWLEDGE_CHAT_SHARED_SECRET (32+ characters) are defined in wp-config.php."
msgstr "wp-config.php에 WP_KNOWLEDGE_CHAT_BACKEND_URL(https)과 WP_KNOWLEDGE_CHAT_SHARED_SECRET(32자 이상)이 정의될 때까지 위젯은 숨겨집니다."

#: includes/class-admin-page.php:208
msgid "Connection test: backend is reachable, the shared secret is accepted and the knowledge base is ready."
msgstr "연결 테스트: 백엔드에 연결되었고, 공유 비밀 키가 승인되었으며, 지식 베이스가 준비되었습니다."

#: includes/class-admin-page.php:210
msgid "Connection test failed: the backend rejected the shared secret. Check that WP_KNOWLEDGE_CHAT_SHARED_SECRET matches CHAT_SHARED_SECRET and that the server clock is correct."
msgstr "연결 테스트 실패: 백엔드가 공유 비밀 키를 거부했습니다. WP_KNOWLEDGE_CHAT_SHARED_SECRET이 CHAT_SHARED_SECRET과 일치하는지, 서버 시계가 정확한지 확인하세요."

#: includes/class-admin-page.php:212
msgid "Connection test failed: the backend is running but its knowledge base is empty."
msgstr "연결 테스트 실패: 백엔드는 실행 중이지만 지식 베이스가 비어 있습니다."

#. translators: %d: HTTP status code, 0 when unreachable.
#: includes/class-admin-page.php:215
#, php-format
msgid "Connection test failed (HTTP status %d). Check the backend URL and that the service is running."
msgstr "연결 테스트 실패(HTTP 상태 %d). 백엔드 URL과 서비스 실행 여부를 확인하세요."

#: includes/class-admin-page.php:223
msgid "Test connection"
msgstr "연결 테스트"

#: includes/class-admin-page.php:231
msgid "You do not have permission to do this."
msgstr "이 작업을 수행할 권한이 없습니다."

#: includes/class-settings.php:139
msgid "Settings were not saved: invalid input."
msgstr "설정이 저장되지 않았습니다: 잘못된 입력입니다."

#: includes/class-settings.php:148
msgid "Enable Chatbot must be checked or unchecked."
msgstr "챗봇 사용은 선택 또는 해제해야 합니다."

#: includes/class-settings.php:149
msgid "Language Switcher must be checked or unchecked."
msgstr "언어 전환은 선택 또는 해제해야 합니다."

#: includes/class-settings.php:150
msgid "Browser Language must be checked or unchecked."
msgstr "브라우저 언어는 선택 또는 해제해야 합니다."

#: includes/class-settings.php:184
#: includes/class-settings.php:214
msgid "Greeting message must be text."
msgstr "인사말은 텍스트여야 합니다."

#: includes/class-settings.php:192
msgid "Default language must be English (en), Indonesian (id) or Korean (ko)."
msgstr "기본 언어는 영어(en), 인도네시아어(id) 또는 한국어(ko)여야 합니다."

#: includes/class-settings.php:221
msgid "Greeting message is required."
msgstr "인사말을 입력해야 합니다."

#. translators: %d: maximum number of characters.
#: includes/class-settings.php:225
#, php-format
msgid "Greeting message must be %d characters or fewer."
msgstr "인사말은 %d자 이하여야 합니다."

#. translators: %s: comma-separated list of approved hostnames.
#: includes/class-settings.php:243
#, php-format
msgid "Contact URL must be an absolute https:// URL on an approved domain (%s), without credentials or a custom port."
msgstr "문의 URL은 승인된 도메인(%s)의 절대 https:// URL이어야 하며, 자격 증명이나 사용자 지정 포트를 포함할 수 없습니다."

#: includes
msgid "WP Knowledge Chat leads"
msgstr "WP Knowledge Chat 상담 요청"

#: includes
msgid "Backend is not configured."
msgstr "백엔드가 구성되지 않았습니다."

#: includes
msgid "Index token or backend URL is not configured."
msgstr "인덱스 토큰 또는 백엔드 URL이 구성되지 않았습니다."

