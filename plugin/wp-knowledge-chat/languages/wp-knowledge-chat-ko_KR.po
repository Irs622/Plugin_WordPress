#. Plugin Name of the plugin
#: wp-knowledge-chat.php
#: includes/class-admin-page.php:30
#: includes/class-admin-page.php:31
msgid "WP Knowledge Chat"
msgstr "WP Knowledge Chat"

#. Description of the plugin
#: wp-knowledge-chat.php
msgid "Inpartner AI Business Consultation Assistant: a floating chat widget that answers visitor questions from approved website content via a separate AI backend."
msgstr "Inpartner AI Business Consultation Assistant: 승인된 웹사이트 콘텐츠를 바탕으로 별도의 AI 백엔드를 통해 방문자 질문에 답하는 플로팅 채팅 위젯입니다."

#. Author of the plugin
#: wp-knowledge-chat.php
msgid "Inpartner"
msgstr "Inpartner"

#: includes/class-admin-page.php:40
#: includes/class-admin-page.php:174
msgid "WP Knowledge Chat Settings"
msgstr "WP Knowledge Chat 설정"

#: includes/class-admin-page.php:41
