<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="php/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">
  <testsuites>
    <testsuite name="wp-knowledge-chat">
      <directory suffix="Test.php">php</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory>../includes</directory>
    </include>
  </source>
  <php>
    <env name="WKC_BACKEND_URL" value="http://127.0.0.1:8787" force="true"/>
    <env name="WKC_SHARED_SECRET" value="phpunit-shared-secret-0123456789abcdef0123" force="true"/>
    <env name="WKC_INDEX_TOKEN" value="phpunit-index-token-0123456789abcdef01234567" force="true"/>
  </php>
</phpunit>
